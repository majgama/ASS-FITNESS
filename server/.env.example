NODE_ENV=development
PORT=3333
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Local: postgresql://postgres:postgres@localhost:5432/ass_fitness
# DigitalOcean: use the managed database URL and set DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ass_fitness
DATABASE_SSL=false

SESSION_DAYS=30
BCRYPT_ROUNDS=12
MAX_FREE_STUDENTS=3
HOTMART_PAID_STUDENT_LIMIT=9999
HOTMART_HOTTOK=change-me
HOTMART_PRODUCT_ID=
UPLOAD_DIR=

SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@assfitness.local
SEED_ADMIN_PASSWORD=Admin@12345
